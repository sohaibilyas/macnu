{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "macnu-lemon-webhook",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "secrets": {
    "required": ["LEMON_WEBHOOK_SECRET", "LEMON_API_KEY"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
